# Trans MCP 环境变量配置
#
# 说明：stdio 模式（trans-mcp）和 HTTP 模式（trans-mcp-http）读的变量不一样，
# 下面分开列。部署 HTTP 服务只需要 MCP_* 这几个。

# ---------- stdio 模式 ----------

# Belindoc API Key
# 仅 stdio 模式需要（服务跑在你自己机器上，用你自己的 key）。
# HTTP 模式不读这个变量：每个客户端自己带 Authorization: Bearer <key>，
# 服务器不存任何密钥——所以别把真实 key 写进服务器的 .env。
# 格式: ft_ + 40位随机串，共43字符
# 获取方式: 登录 https://belindoc.com → 开放平台 → API Key 管理
BELINDOC_API_KEY=ft_your_api_key_here

# ---------- HTTP 模式 ----------

# 监听地址 (可选，默认 0.0.0.0)
# MCP_HOST=0.0.0.0

# 监听端口 (可选，默认 8080)
# MCP_PORT=8080

# MCP 服务端点路径 (可选，默认 /mcp)
# 同域名下落地页已占用 /mcp 时，把服务挪到别的路径。
# 客户端 URL 要同步改成 http://<host>:<port><MCP_PATH>
# MCP_PATH=/api/mcp

# 用户可见文案的语言 (可选，默认 zh)
# 可选值：zh / zh-Hant / en / ja / ko / de / fr / ru / ar（与 free-pdf-translate 对齐）
# 只影响会被念给用户听的那部分：任务状态、产出说明、进度行、失败原因、下载说明；
# 工具描述和给模型的操作指令始终是中文。
# 调用方也可以在工具参数里带 locale，那个优先级更高，本变量只是兜底。
# MCP_LOCALE=zh

# ---------- 上游地址 ----------

# Belindoc 开放 API 地址 (可选，默认测试环境 http://internal-test-host:6101)
# 切生产环境设成 https://belindoc.com/api，不用改源码。
# stdio 和 HTTP 两种模式都读它；末尾斜杠会被自动去掉。
# BELINDOC_API_BASE_URL=https://belindoc.com/api
