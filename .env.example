# Trans MCP 环境变量配置

# Belindoc API Key (必填)
# 格式: ft_ + 40位随机串，共43字符
# 获取方式: 登录 https://belindoc.com → 开放平台 → API Key 管理
BELINDOC_API_KEY=ft_your_api_key_here

# API 基础地址 (可选，默认使用生产环境)
# API_BASE_URL=http://internal-test-host:6102

# MCP 服务端点路径 (可选，默认 /mcp)
# 同域名下落地页已占用 /mcp 时，把服务挪到别的路径
# MCP_PATH=/api/mcp
